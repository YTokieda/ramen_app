<header class="navbar navbar-fixed-top navbar-inverse">
  <div class="container">
    <%= link_to root_path, id: "logo" do %>
      <%= image_tag "logo-icon.png", alt: "", class: "logo-icon" %>
      <span class="logo-text">
        <span class="logo-ribbon"><%= t("site.ribbon") %></span>
        <span class="logo-main"><%= t("site.main") %></span>
      </span>
    <% end %>
    <nav>
      <div class="navbar-header">
        <button id="hamburger" type="button" class="navbar-toggle collapsed">
          <span class="sr-only"><%= t("nav.menu_open") %></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
      </div>
      <ul id="navbar-menu"
          class="nav navbar-nav navbar-right collapse navbar-collapse">
        <li><%= link_to t("nav.home"), root_path %></li>
        <li><%= link_to t("nav.shops"), shops_path %></li>
        <li><%= link_to t("nav.help"), help_path %></li>

        <% if logged_in? %>
          <% if current_user.admin? %>
            <li class="dropdown">
              <a href="#" id="admin-menu-toggle" class="dropdown-toggle">
                管理 <b class="caret"></b>
              </a>
              <ul id="admin-dropdown-menu" class="dropdown-menu">
                <li><%= link_to "卵情報の確認待ち", admin_verifications_path %></li>
                <li><%= link_to "店舗申請", admin_shop_submissions_path %></li>
                <li><%= link_to "店舗オーナー申請", admin_shop_owners_path %></li>
                <li><%= link_to "お問い合わせ", admin_inquiries_path %></li>
                <li class="divider"></li>
                <li><%= link_to "操作ログ", admin_admin_audit_logs_path %></li>
              </ul>
            </li>
          <% end %>

          <li><%= link_to "店舗管理", dashboard_shop_owners_path %></li>

          <li class="dropdown">
            <a href="#" id="account" class="dropdown-toggle">
              アカウント <b class="caret"></b>
            </a>
            <ul id="dropdown-menu" class="dropdown-menu">
              <li><%= link_to "プロフィール", current_user %></li>
              <li><%= link_to "設定", edit_user_path(current_user) %></li>
              <li class="divider"></li>
              <li>
                <%= link_to "ログアウト", logout_path,
                            data: { "turbo-method": :delete } %>
              </li>
            </ul>
          </li>
        <% else %>
          <li><%= link_to t("nav.login"), login_path(locale: nil) %></li>
        <% end %>
        <li class="locale-switch">
          <%= link_to t("site.switch_to"), switch_locale_path(t("site.switch_locale")),
                      lang: t("site.switch_locale"), hreflang: t("site.switch_locale") %>
        </li>
      </ul>
    </nav>
  </div>
</header>
