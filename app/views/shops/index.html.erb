<% provide(:title, t("shops.index.title")) %>
<% provide(:description, t("seo.shops_description")) %>
<h1><%= t("shops.index.title") %></h1>

<p class="home-notice"><%= t("safety_notice") %></p>
<% if t("data_language_note").present? %>
  <p class="data-language-note"><%= t("data_language_note") %></p>
<% end %>

<%= form_with url: shops_path, method: :get, local: true, class: "shop-search" do |f| %>
  <div>
    <%= f.label :keyword, t("shops.index.keyword") %>
    <%= f.text_field :keyword,
                     value: @keyword,
                     placeholder: t("shops.index.keyword_placeholder"),
                     class: "form-control" %>
  </div>

  <div>
    <%= f.label :prefecture, t("shops.index.prefecture") %>
    <%= f.select :prefecture,
      [[t("shops.index.all"), ""]] +
        @prefecture_counts.map { |name, count| ["#{Prefecture.label(name)}（#{count}）", name] },
      { selected: @prefecture },
      { class: "form-control" } %>
  </div>

  <div>
    <%= f.label :egg_status, t("shops.index.egg_status") %>
    <%= f.select :egg_status,
      [
        [t("shops.index.all"), ""],
        [t("shops.index.egg_free"), "egg_free"],
        [t("shops.index.contains_egg"), "contains_egg"],
        [t("shops.index.unknown"), "unknown"]
      ],
      { selected: @egg_status },
      { class: "form-control" } %>
  </div>

  <div>
    <%= f.label :category, t("shops.index.category") %>
    <%= f.select :category,
      [
        [t("shops.index.all"), ""],
        [t("shops.index.cat_noodle_soup"), "noodle_soup"],
        [t("shops.index.cat_topping"), "topping"],
        [t("shops.index.cat_cooking_environment"), "cooking_environment"]
      ],
      { selected: @category },
      { class: "form-control" } %>
  </div>

  <%= f.submit t("shops.index.search"), class: "btn btn-primary", name: nil %>
  <%= link_to t("shops.index.clear"), shops_path %>
<% end %>

<p>
  <% if logged_in? %>
    <%= link_to t("shops.index.submit_shop"), new_shop_submission_path %>
  <% else %>
    <%= t("shops.index.login_to_submit_html", link: link_to(t("shops.index.login"), login_path(locale: nil))) %>
  <% end %>
</p>

<p><%= t("shops.index.result_count", count: @shops.size) %></p>

<% if @shops.any? %>
  <% @shops.each do |shop| %>
    <div class="shop">
      <h2>
        <%= link_to shop.name, shop_path(shop) %>
      </h2>

      <p class="shop-address"><%= shop.address %></p>

      <% summaries = @verification_summaries.fetch(shop.id, []) %>
      <% visible_summaries = summaries.first(3) %>
      <% remaining_count = summaries.size - visible_summaries.size %>

      <% if summaries.any? %>
        <% visible_summaries.each do |summary| %>
          <%= render "verification_summary",
                     verification: summary[:verification],
                     conflicting: summary[:conflicting] %>
        <% end %>

        <% if remaining_count > 0 %>
          <p><%= t("shops.index.more", count: remaining_count) %></p>
        <% end %>

        <% if summaries.drop(3).any? { |summary| summary[:conflicting] } %>
          <p class="verification-conflict-warning"><%= t("shops.index.hidden_conflict") %></p>
        <% end %>

        <p>
          <%= link_to t("shops.index.see_all"), shop_path(shop) %>
        </p>
      <% else %>
        <p><%= t("shops.index.no_info") %></p>
      <% end %>
    </div>
  <% end %>
<% else %>
  <p><%= t("shops.index.no_result") %></p>
<% end %>
