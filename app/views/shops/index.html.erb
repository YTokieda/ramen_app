<h1>卵アレルギー対応ラーメン店</h1>

<p>
  <% if logged_in? %>
    <%= link_to "掲載されていない店舗を情報提供する",
                new_shop_submission_path %>
  <% else %>
    店舗情報を提供するには
    <%= link_to "ログイン", login_path %>
    してください。
  <% end %>
</p>

<% @shops.each do |shop| %>
  <div class="shop">
    <h2>
      <%= link_to shop.name, shop_path(shop) %>
    </h2>

    <p>
      <%= shop.address %>
    </p>

    <% if shop.egg_free? %>
      <p>卵不使用情報あり</p>
    <% end %>
  </div>
<% end %>