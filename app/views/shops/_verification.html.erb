<div class="verification">
  <% histories = verification_histories.fetch(
       [verification.menu_item_id, verification.category], []
     ) %>

  <% same_day_status =
       verification_same_day_status(verification, histories) %>

  <div class="verification-summary-head">
    <% if same_day_status == :conflict %>
      <%= egg_status_conflict_badge %>
    <% else %>
      <%= egg_status_badge(verification.egg_status) %>
    <% end %>
    <strong><%= verification_target_name(verification) %></strong>
    <span class="category-chip">
      <%= verification_category_label(verification.category) %>
    </span>
  </div>

  <p>
    <strong><%= t("verification.source") %><%= t("punct.colon") %></strong>
    <%= verification_source_label(verification.source_type) %>
  </p>

  <p>
    <strong><%= t("verification.method") %><%= t("punct.colon") %></strong>
    <%= verification.verification_method %>
  </p>

  <p>
    <strong><%= t("verification.verified_on") %><%= t("punct.colon") %></strong>
    <%= verification.verified_on %>
  </p>

  <% freshness_message =
       verification_freshness_label(verification.verified_on) %>

  <% if freshness_message.present? %>
    <p class="verification-freshness-warning">
      <%= freshness_message %>
    </p>
  <% end %>

  <% if verification.note.present? %>
    <p>
      <strong><%= t("verification.note") %><%= t("punct.colon") %></strong>
      <%= verification.note %>
    </p>
  <% end %>

  <p>
    <strong><%= t("verification.status") %><%= t("punct.colon") %></strong>
    <%= verification_status_label(verification.status) %>
  </p>


  <% history_status =
       verification_history_status(verification, histories) %>

  <% if same_day_status == :conflict %>
    <div class="verification-conflict-warning">
      <p>
        <strong><%= t("verification.conflict_title") %></strong>
      </p>
      <p>
        <%= t("verification.conflict_body") %>
      </p>
    </div>

  <% elsif same_day_status == :uncertain %>
    <div class="verification-freshness-warning">
      <p>
        <strong><%= t("verification.same_day_uncertain_title") %></strong>
      </p>
      <p>
        <%= t("verification.same_day_uncertain_body") %>
      </p>
    </div>

  <% elsif history_status == :changed %>
    <div class="verification-conflict-warning">
      <p>
        <strong><%= t("verification.changed_title") %></strong>
      </p>
      <p>
        <%= t("verification.changed_body") %>
      </p>
    </div>

  <% elsif history_status == :uncertain %>
    <div class="verification-freshness-warning">
      <p>
        <strong><%= t("verification.history_uncertain_title") %></strong>
      </p>
      <p>
        <%= t("verification.history_uncertain_body") %>
      </p>
    </div>
  <% end %>

  <%= render "verification_history",
             histories: histories %>
</div>