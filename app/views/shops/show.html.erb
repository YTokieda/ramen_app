
<% if @shop.hidden? %>
  <p class="alert alert-warning">この店舗は非公開です（管理者にだけ表示されています）。</p>
<% end %>
<div class="shop-header">
  <h1><%= @shop.name %></h1>
  <p class="shop-address"><%= @shop.address %></p>

  <% if @shop.description.present? %>
    <p><%= @shop.description %></p>
  <% end %>
</div>

<p class="home-notice"><%= t("safety_notice") %></p>
<% if t("data_language_note").present? %>
  <p class="data-language-note"><%= t("data_language_note") %></p>
<% end %>



<h2><%= t("shops.show.menu") %></h2>

<% if @menu_items.any? %>
  <div class="menu-list">
    <% @menu_items.each do |menu_item| %>
      <div class="card">
        <h3><%= menu_item.name %></h3>

        <% if menu_item.description.present? %>
          <p><%= menu_item.description %></p>
        <% end %>

        <% if logged_in? && current_user.admin? %>
          <%= button_to "メニューを削除（運営）", admin_menu_item_path(menu_item), method: :delete,
                        class: "btn btn-danger btn-xs",
                        form: { data: { turbo_confirm: "「#{menu_item.name}」を削除しますか？このメニューの卵情報もすべて消え、元に戻せません。" } } %>
        <% end %>

        <% if logged_in? %>
          <p>
            <%= link_to "このメニューの卵情報を提供する",
                        new_shop_verification_path(
                          @shop,
                          menu_item_id: menu_item.id
                        ) %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p><%= t("shops.show.no_menu") %></p>
<% end %>

<% if logged_in? %>
  <p>
    <%= link_to "メニューを追加する",
                new_shop_menu_item_path(@shop) %>
  </p>
<% end %>


<h2><%= t("shops.show.cooking_environment") %></h2>

<p><%= t("shops.show.cooking_environment_desc") %></p>


<h2><%= t("shops.show.egg_info") %></h2>

<% if @approved_verifications.any? %>
  <%= render partial: "verification",
             collection: @approved_verifications,
             as: :verification,
             locals: {
               verification_histories: @verification_histories
             } %>
<% else %>
  <p><%= t("shops.show.no_egg_info") %></p>
<% end %>


<% if logged_in? && @my_unapproved_verifications.any? %>
  <h2>あなたが提供した確認情報</h2>

  <% @my_unapproved_verifications.each do |verification| %>
    <div>
      <% if verification.menu_item.present? %>
        <p>
          <strong>対象メニュー：</strong>
          <%= verification.menu_item.name %>
        </p>
      <% else %>
        <p>
          <strong>対象：</strong>
          店舗の調理環境
        </p>
      <% end %>

      <p>
        <strong>確認項目：</strong>
        <%= verification_category_label(verification.category) %>
      </p>

      <p>
        <strong>確認状況：</strong>
        <%= verification_status_label(verification.status) %>
      </p>

      <p>
        <strong>確認日：</strong>
        <%= verification.verified_on %>
      </p>

      <% if verification.evidence_files.attached? %>
        <p>
          <strong>添付した根拠資料：</strong>
        </p>

        <ul>
          <% verification.evidence_files.each do |file| %>
            <li>
              <%= link_to file.filename.to_s,
                          verification_evidence_file_path(
                            verification, file
                          ) %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <hr>
  <% end %>
<% end %>


<% if logged_in? && @my_approved_verifications.any? %>
  <h2>あなたの承認済み確認情報・添付資料</h2>

  <% @my_approved_verifications.each do |verification| %>
    <div>
      <% if verification.menu_item.present? %>
        <p>
          <strong>対象メニュー：</strong>
          <%= verification.menu_item.name %>
        </p>
      <% else %>
        <p>
          <strong>対象：</strong>
          店舗の調理環境
        </p>
      <% end %>

      <p>
        <strong>確認項目：</strong>
        <%= verification_category_label(verification.category) %>
      </p>

      <p>
        <strong>確認日：</strong>
        <%= verification.verified_on %>
      </p>

      <% if verification.evidence_files.attached? %>
        <p>
          <strong>添付した根拠資料：</strong>
        </p>

        <ul>
          <% verification.evidence_files.each do |file| %>
            <li>
              <%= link_to file.filename.to_s,
                          verification_evidence_file_path(
                            verification, file
                          ) %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <hr>
  <% end %>
<% end %>


<% if logged_in? %>
  <p>
    <%= link_to "店舗の調理環境について情報を提供する",
                new_shop_verification_path(
                  @shop,
                  category: "cooking_environment"
                ) %>
  </p>
<% end %>


<% if logged_in? %>
  <p>
    <%= link_to "この店舗のオーナーです",
                new_shop_owner_path(shop_id: @shop.id) %>
  </p>

  <h2>口コミを投稿する</h2>

  <% if @review.errors.any? %>
    <div>
      <p>口コミを投稿できませんでした。</p>

      <ul>
        <% @review.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: [@shop, @review]) do |f| %>
    <div>
      <%= f.label :content, "口コミ" %>
      <%= f.text_area :content %>
    </div>

    <div>
      <%= f.label :images, "写真" %>
      <%= f.file_field :images,
                       multiple: true,
                       accept: "image/jpeg,image/png,image/webp" %>

      <p>
        JPEG・PNG・WebP形式、最大3枚、1枚5MBまで
      </p>
    </div>

    <%= f.submit "口コミを投稿する" %>
  <% end %>
<% else %>
  <p>
    <%= t("shops.show.login_to_review_html", link: link_to(t("shops.show.login"), login_path(locale: nil))) %>
  </p>
<% end %>


<h2><%= t("shops.show.reviews") %></h2>

<% if @reviews.any? %>
  <% @reviews.each do |review| %>
    <div class="review" id="review-<%= review.id %>">
      <p>
        <strong><%= review.user.name %></strong>
      </p>

      <p>
        <%= review.content %>
      </p>

      <% if review.review_reply %>
        <div class="owner-reply">
          <strong><%= t("shops.show.owner_reply") %></strong>

          <p>
            <%= review.review_reply.content %>
          </p>
        </div>
      <% else %>
        <% shop_owner =
             current_user&.shop_owners&.find_by(
               shop: @shop,
               status: "approved"
             ) %>

        <% if shop_owner %>
          <%= form_with(
                model: ReviewReply.new,
                url: shop_review_review_reply_path(
                  @shop, review
                )
              ) do |f| %>

            <%= f.text_area :content %>
            <%= f.submit "店舗として返信する" %>
          <% end %>
        <% end %>
      <% end %>

      <% if review.images.attached? %>
        <% review.images.each do |image| %>
          <%= image_tag review_image_path(review, image),
                        width: 300,
                        alt: t("shops.show.review_image") %>
        <% end %>
      <% end %>

      <p>
        <%= t("shops.show.posted_on", date: review.created_at.strftime("%Y/%m/%d")) %>
      </p>

      <% helpful_count = @reaction_counts[review.id].to_i %>
      <div class="review-reactions">
        <% if logged_in? && current_user != review.user %>
          <% if @my_reacted_review_ids.include?(review.id) %>
            <%= button_to shop_review_reaction_path(@shop, review), method: :delete,
                          class: "reaction-button reaction-button--on",
                          form: { class: "reaction-form" },
                          aria: { pressed: true, label: t("shops.show.helpful_undo") } do %>
              👍 <%= t("shops.show.helpful") %> <span class="reaction-count"><%= helpful_count %></span>
            <% end %>
          <% else %>
            <%= button_to shop_review_reaction_path(@shop, review),
                          class: "reaction-button",
                          form: { class: "reaction-form" },
                          aria: { pressed: false } do %>
              👍 <%= t("shops.show.helpful") %> <span class="reaction-count"><%= helpful_count %></span>
            <% end %>
          <% end %>
        <% elsif helpful_count.positive? %>
          <span class="reaction-summary">👍 <%= t("shops.show.helpful_count", count: helpful_count) %></span>
        <% end %>
      </div>

      <% if logged_in? && current_user.admin? && current_user != review.user %>
        <%= button_to "口コミを削除（運営）", admin_review_path(review), method: :delete,
                      class: "btn btn-danger btn-xs",
                      form: { data: { turbo_confirm: "この口コミを削除しますか？元に戻せません。" } } %>
      <% end %>

      <% if current_user == review.user %>
        <%= link_to "削除",
                    shop_review_path(@shop, review),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "本当に削除しますか？"
                    } %>
      <% end %>
    </div>

    <hr>
  <% end %>
<% else %>
  <p><%= t("shops.show.no_reviews") %></p>
<% end %>


<% if logged_in? %>
  <p>
    <%= link_to "掲載されていない店舗を情報提供する",
                new_shop_submission_path %>
  </p>
<% end %>

<p>
  <%= link_to t("shops.show.back"), shops_path %>
</p>
