
<h1><%= @shop.name %></h1>

<p>
  <strong>住所：</strong>
  <%= @shop.address %>
</p>

<% if @shop.description.present? %>
  <p>
    <strong>店舗説明：</strong>
    <%= @shop.description %>
  </p>
<% end %>



<h2>メニュー</h2>

<% if @menu_items.any? %>
  <% @menu_items.each do |menu_item| %>
    <div>
      <h3><%= menu_item.name %></h3>

      <% if menu_item.description.present? %>
        <p><%= menu_item.description %></p>
      <% end %>
    </div>

    <% if logged_in? %>
      <p>
        <%= link_to "このメニューの卵情報を提供する",
                    new_shop_verification_path(
                      @shop,
                      menu_item_id: menu_item.id
                    ) %>
      </p>
    <% end %>
  <% end %>
<% else %>
  <p>メニュー情報はまだ登録されていません。</p>
<% end %>

<% if logged_in? %>
  <p>
    <%= link_to "メニューを追加する",
                new_shop_menu_item_path(@shop) %>
  </p>
<% end %>


<h2>調理環境</h2>

<p>
  共通の調理器具や茹で湯など、
  店舗の調理環境についての情報です。
</p>


<h2>卵に関する確認情報</h2>

<% if @approved_verifications.any? %>
  <%= render partial: "verification",
             collection: @approved_verifications,
             as: :verification,
             locals: {
               verification_histories: @verification_histories
             } %>
<% else %>
  <p>現在、運営確認済みの卵情報はありません。</p>
<% end %>


<% if logged_in? && @my_unapproved_verifications.any? %>
  <h2>あなたが提供した確認情報</h2>

  <% @my_unapproved_verifications.each do |verification| %>
    <div>
      <% if verification.menu_item.present? %>
        <p>
          <strong>対象メニュー：</strong>
          <%= verification.menu_item.name %>
        </p>
      <% else %>
        <p>
          <strong>対象：</strong>
          店舗の調理環境
        </p>
      <% end %>

      <p>
        <strong>確認項目：</strong>
        <%= verification_category_label(verification.category) %>
      </p>

      <p>
        <strong>確認状況：</strong>
        <%= verification_status_label(verification.status) %>
      </p>

      <p>
        <strong>確認日：</strong>
        <%= verification.verified_on %>
      </p>

      <% if verification.evidence_files.attached? %>
        <p>
          <strong>添付した根拠資料：</strong>
        </p>

        <ul>
          <% verification.evidence_files.each do |file| %>
            <li>
              <%= link_to file.filename.to_s,
                          verification_evidence_file_path(
                            verification, file
                          ) %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <hr>
  <% end %>
<% end %>


<% if logged_in? && @my_approved_verifications.any? %>
  <h2>あなたの承認済み確認情報・添付資料</h2>

  <% @my_approved_verifications.each do |verification| %>
    <div>
      <% if verification.menu_item.present? %>
        <p>
          <strong>対象メニュー：</strong>
          <%= verification.menu_item.name %>
        </p>
      <% else %>
        <p>
          <strong>対象：</strong>
          店舗の調理環境
        </p>
      <% end %>

      <p>
        <strong>確認項目：</strong>
        <%= verification_category_label(verification.category) %>
      </p>

      <p>
        <strong>確認日：</strong>
        <%= verification.verified_on %>
      </p>

      <% if verification.evidence_files.attached? %>
        <p>
          <strong>添付した根拠資料：</strong>
        </p>

        <ul>
          <% verification.evidence_files.each do |file| %>
            <li>
              <%= link_to file.filename.to_s,
                          verification_evidence_file_path(
                            verification, file
                          ) %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <hr>
  <% end %>
<% end %>


<% if logged_in? %>
  <p>
    <%= link_to "店舗の調理環境について情報を提供する",
                new_shop_verification_path(
                  @shop,
                  category: "cooking_environment"
                ) %>
  </p>
<% end %>


<% if logged_in? %>
  <p>
    <%= link_to "この店舗のオーナーです",
                new_shop_owner_path(shop_id: @shop.id) %>
  </p>

  <h2>口コミを投稿する</h2>

  <% if @review.errors.any? %>
    <div>
      <p>口コミを投稿できませんでした。</p>

      <ul>
        <% @review.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: [@shop, @review]) do |f| %>
    <div>
      <%= f.label :content, "口コミ" %>
      <%= f.text_area :content %>
    </div>

    <div>
      <%= f.label :images, "写真" %>
      <%= f.file_field :images,
                       multiple: true,
                       accept: "image/jpeg,image/png,image/webp" %>

      <p>
        JPEG・PNG・WebP形式、最大3枚、1枚5MBまで
      </p>
    </div>

    <%= f.submit "口コミを投稿する" %>
  <% end %>
<% else %>
  <p>
    口コミを投稿するには
    <%= link_to "ログイン", login_path %>
    してください。
  </p>
<% end %>


<h2>口コミ</h2>

<% if @reviews.any? %>
  <% @reviews.each do |review| %>
    <div class="review">
      <p>
        <strong><%= review.user.name %></strong>
      </p>

      <p>
        <%= review.content %>
      </p>

      <% if review.review_reply %>
        <div class="owner-reply">
          <strong>店舗からの返信</strong>

          <p>
            <%= review.review_reply.content %>
          </p>
        </div>
      <% else %>
        <% shop_owner =
             current_user&.shop_owners&.find_by(
               shop: @shop,
               status: "approved"
             ) %>

        <% if shop_owner %>
          <%= form_with(
                model: ReviewReply.new,
                url: shop_review_review_reply_path(
                  @shop, review
                )
              ) do |f| %>

            <%= f.text_area :content %>
            <%= f.submit "店舗として返信する" %>
          <% end %>
        <% end %>
      <% end %>

      <% if review.images.attached? %>
        <% review.images.each do |image| %>
          <%= image_tag review_image_path(review, image),
                        width: 300,
                        alt: "口コミ画像" %>
        <% end %>
      <% end %>

      <p>
        投稿日：<%= review.created_at.strftime("%Y/%m/%d") %>
      </p>

      <% if current_user == review.user %>
        <%= link_to "削除",
                    shop_review_path(@shop, review),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "本当に削除しますか？"
                    } %>
      <% end %>
    </div>

    <hr>
  <% end %>
<% else %>
  <p>まだ口コミはありません。</p>
<% end %>


<% if logged_in? %>
  <p>
    <%= link_to "掲載されていない店舗を情報提供する",
                new_shop_submission_path %>
  </p>
<% end %>

<p>
  <%= link_to "店舗一覧に戻る", shops_path %>
</p>
