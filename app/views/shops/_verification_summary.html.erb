<div class="verification-summary">
  <div class="verification-summary-head">
    <% if conflicting %>
      <%= egg_status_conflict_badge %>
    <% else %>
      <%= egg_status_badge(verification.egg_status) %>
    <% end %>
    <strong><%= verification_target_name(verification) %></strong>
    <span class="category-chip">
      <%= verification_category_label(verification.category) %>
    </span>
  </div>

  <% if conflicting %>
    <p class="verification-conflict-warning"><%= t("verification.conflict_short") %></p>
  <% end %>

  <p class="verification-meta">
    <%= t("verification.source") %><%= t("punct.colon") %><%= verification_source_label(verification.source_type) %>
    <%= t("punct.sep") %><%= t("verification.verified_on") %><%= t("punct.colon") %><%= verification.verified_on || t("verification.unknown_date") %>
    <%= t("punct.sep") %><%= t("verification.approved_short") %>
  </p>

  <% freshness_message =
       verification_freshness_label(verification.verified_on) %>

  <% if freshness_message.present? %>
    <p class="verification-freshness-warning">
      <%= freshness_message %>
    </p>
  <% end %>
</div>
