<% if histories.any? %>
  <details>
    <summary>
      <%= t("verification.history_toggle", count: histories.size) %>
    </summary>

    <ul>
      <% histories.each do |history| %>
        <li>
          <p>
            <strong><%= t("verification.verified_on") %><%= t("punct.colon") %></strong>
            <%= history.verified_on %>
          </p>

          <p>
            <strong><%= t("verification.egg_status") %><%= t("punct.colon") %></strong>
            <%= egg_status_badge(history.egg_status) %>
          </p>

          <p>
            <strong><%= t("verification.source") %><%= t("punct.colon") %></strong>
            <%= verification_source_label(history.source_type) %>
          </p>

          <p>
            <strong><%= t("verification.method") %><%= t("punct.colon") %></strong>
            <%= history.verification_method %>
          </p>

          <% if history.note.present? %>
            <p>
              <strong><%= t("verification.note") %><%= t("punct.colon") %></strong>
              <%= history.note %>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>