<h1>店舗情報を提供する</h1>

<% if @shop_submission.errors.any? %>
  <div>
    <p>入力内容を確認してください。</p>

    <ul>
      <% @shop_submission.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: @shop_submission) do |f| %>

  <div>
    <%= f.label :name, "店舗名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :description, "店舗情報" %>
    <%= f.text_area :description %>
  </div>

  <%= f.submit "店舗情報を送信する" %>

<% end %>