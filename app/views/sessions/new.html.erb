<% provide(:title, "ログイン") %>
<h1>ログイン</h1>

<div class="row">
  <div class="col-md-6 col-md-offset-3 card auth-card">
    <%= form_with(url: login_path, scope: :session) do |f| %>

      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, class: 'form-control', autocomplete: "email" %>

      <%= f.label :password, "パスワード" %>
      <%= link_to "（パスワードを忘れた方）", new_password_reset_path %>
      <%= f.password_field :password, class: 'form-control', autocomplete: "current-password" %>

      <%= f.label :remember_me, class: "checkbox inline" do %>
        <%= f.check_box :remember_me %>
        <span>ログインしたままにする</span>
      <% end %>

      <%= f.submit "ログイン", class: "btn btn-primary" %>
    <% end %>

    <p class="auth-links">はじめての方は <%= link_to "会員登録（無料）", signup_path %></p>
    <p class="auth-links"><%= link_to "登録確認メールが届かない方", new_account_activation_path %></p>
  </div>
</div>
