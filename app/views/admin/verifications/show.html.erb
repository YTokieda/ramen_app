<h1>卵情報の確認</h1>

<p>
  <strong>店舗：</strong>
  <%= @verification.shop.name %>
</p>


<% if @verification.menu_item.present? %>

  <p>
    <strong>対象メニュー：</strong>
    <%= @verification.menu_item.name %>
  </p>

<% else %>

  <p>
    <strong>対象：</strong>
    店舗の調理環境
  </p>

<% end %>


<p>
  <strong>確認項目：</strong>
  <%= verification_category_label(@verification.category) %>
　
</p>


<p>
  <strong>卵の使用状況：</strong>
  <%= egg_status_label(@verification.egg_status) %>
</p>


<p>
  <strong>情報源：</strong>
  <%= verification_source_label(@verification.source_type) %>
</p>

<p>
  <strong>確認方法：</strong>
  <%= @verification.verification_method %>
</p>


<p>
  <strong>確認日：</strong>
  <%= @verification.verified_on %>
</p>


<% if @verification.note.present? %>
  <p>
    <strong>補足：</strong>
    <%= @verification.note %>
  </p>
<% end %>


<p>
  <strong>投稿者：</strong>
  <%= @verification.user.name %>
</p>


<p>
  <strong>投稿日：</strong>
  <%= @verification.created_at %>
</p>


<p>
  <strong>現在の状態：</strong>
  <%= verification_status_label(@verification.status) %>
</p>


<% if @verification.status == "pending" %>

  <p>
    <%= button_to "承認する",
                  approve_admin_verification_path(@verification),
                  method: :patch %>
  </p>

  <p>
    <%= button_to "却下する",
                  reject_admin_verification_path(@verification),
                  method: :patch %>
  </p>

<% end %>


<p>
  <%= link_to "確認待ち一覧へ戻る",
              admin_verifications_path %>
</p>