<h1>店舗オーナー申請</h1>

<p>
  <strong>店舗：</strong>
  <%= @shop_owner.shop.name %>
</p>

<p>
  <strong>住所：</strong>
  <%= @shop_owner.shop.address %>
</p>

<p>
  <strong>申請者：</strong>
  <%= @shop_owner.user.name %>
</p>

<p>
  <strong>メール：</strong>
  <%= @shop_owner.user.email %>
</p>

<p>
  <strong>申請者の氏名：</strong>
  <%= @shop_owner.applicant_name.presence || "（未入力）" %>
  <% if @shop_owner.role_label %>（<%= @shop_owner.role_label %>）<% end %>
</p>

<p>
  <strong>お店の電話番号：</strong>
  <% if @shop_owner.shop_phone.present? %>
    <%= link_to @shop_owner.shop_phone, "tel:#{@shop_owner.shop_phone}" %>
  <% else %>
    （未入力）
  <% end %>
</p>

<p class="form-hint">
  承認の前に、この番号がお店の公式サイトや地図サービスに載っている番号と同じか確かめ、お店に電話して申請者を確認してください。
</p>

<p>
  <strong>ステータス：</strong>
  <%= @shop_owner.status %>
</p>

<% if @shop_owner.business_license.attached? %>
  <p>
    <strong>店舗確認資料：</strong>
    <%= link_to "営業許可証をダウンロード",
            admin_shop_owner_business_license_path(@shop_owner) %>
  </p>
<% elsif @shop_owner.reviewed_at %>
  <p>店舗確認資料は、審査から<%= ShopOwner::LICENSE_RETENTION.in_days.to_i %>日がたったため削除しました。</p>
<% else %>
  <p>店舗確認資料は提出されていません。</p>
<% end %>

<% if @shop_owner.status == "pending" %>

  <%= button_to "承認",
                approve_admin_shop_owner_path(@shop_owner),
                method: :patch,
                data: {
                  turbo_confirm: "この店舗オーナー申請を承認しますか？"
                } %>

  <%= button_to "却下",
                reject_admin_shop_owner_path(@shop_owner),
                method: :patch,
                data: {
                  turbo_confirm: "この店舗オーナー申請を却下しますか？"
                } %>

<% end %>

<p>
  <%= link_to "申請一覧へ戻る",
              admin_shop_owners_path %>
</p>