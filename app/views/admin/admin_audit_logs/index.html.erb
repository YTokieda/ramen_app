<h1>管理者操作履歴</h1>

<p>
  承認・却下・非公開・削除などの操作の最新100件を表示しています。
</p>

<% if @admin_audit_logs.any? %>
  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>操作日時</th>
          <th>管理者</th>
          <th>対象</th>
          <th>対象ID</th>
          <th>操作</th>
          <th>変更前</th>
          <th>変更後</th>
        </tr>
      </thead>

      <tbody>
        <% @admin_audit_logs.each do |log| %>
          <tr>
            <td>
              <%= l(log.created_at, format: :long) %>
            </td>

            <td>
              <%= log.admin_user&.name || "不明" %>
            </td>

            <td>
              <%= log.target_type %>
            </td>

            <td>
              <%= log.target_id %>
            </td>

            <td>
              <%= log.action_type %>
            </td>

            <td>
              <%= log.previous_status %>
            </td>

            <td>
              <%= log.new_status %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>操作履歴はまだありません。</p>
<% end %>