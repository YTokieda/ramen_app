<h1>店舗管理</h1>

<% if @shop_owners.any? %>

  <% @shop_owners.each do |shop_owner| %>
    <div>
      <h2>
        <%= shop_owner.shop.name %>
      </h2>

      <p>
        <%= shop_owner.shop.address %>
      </p>
      
      <p>
        <%= link_to "店舗情報を編集",
                    edit_shop_shop_owner_path(shop_owner) %>
      </p>

      <p>
        <%= link_to "店舗ページを見る",
                    shop_path(shop_owner.shop) %>
      </p>
    </div>

    <hr>
  <% end %>

<% else %>

  <p>現在、管理できる店舗はありません。</p>

<% end %>