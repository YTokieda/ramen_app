<h1>店舗オーナー申請</h1>

<h2><%= @shop.name %></h2>

<p>
  <%= @shop.address %>
</p>

<p>
  この店舗のオーナー・店舗関係者であることを
  運営へ申請します。
</p>

<% if @shop_owner.errors.any? %>
  <ul>
    <% @shop_owner.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with(model: @shop_owner) do |f| %>

  <%= f.hidden_field :shop_id,
                     value: @shop.id %>

  <div>
    <%= f.label :business_license,
                "店舗確認資料" %>

    <%= f.file_field :business_license %>
  </div>

  <p>
    営業許可証など、店舗との関係を確認できる資料を
    アップロードできます。
  </p>

  <%= f.submit "オーナー申請を送信する" %>

<% end %>