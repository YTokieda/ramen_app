<% provide(:title, "アカウント設定") %>
<h1>アカウント設定</h1>

<div class="row">
  <div class="col-md-6 col-md-offset-3 card auth-card">
    <%= form_with(model: @user) do |f| %>
      <%= render 'shared/error_messages', object: f.object %>

      <%= f.label :name, "ニックネーム（公開されます）" %>
      <%= f.text_field :name, class: 'form-control', maxlength: 30,
                       placeholder: "例：卵アレルギーの子の親" %>
      <p class="form-hint">口コミなどに表示されます。本名やメールアドレスは入力しないでください。</p>

      <div class="avatar-field" data-controller="avatar-resize">
        <%= f.label :avatar, "プロフィール画像（任意・公開されます）" %>
        <div class="avatar-field-row">
          <span data-avatar-resize-target="current"><%= user_avatar(@user, size: 72) %></span>
          <img data-avatar-resize-target="preview" class="avatar" width="72" height="72" alt="" hidden>
          <%= f.file_field :avatar, accept: "image/jpeg,image/png,image/webp",
                           data: { avatar_resize_target: "input", action: "change->avatar-resize#resize" } %>
        </div>
        <p class="form-hint">写真やイラストを設定できます（JPEG・PNG・WebP）。口コミなどでニックネームの横に表示されます。顔写真など、個人が特定できる画像は避けることをおすすめします。</p>
        <% if @user.avatar.attached? %>
          <label class="avatar-remove">
            <%= check_box_tag "user[remove_avatar]", "1", false %> 画像を削除する
          </label>
        <% end %>
      </div>

      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, class: 'form-control', autocomplete: "email" %>

      <p class="form-hint">パスワードを変更しない場合は、下の2つは空欄のままにしてください。</p>
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, class: 'form-control', autocomplete: "new-password" %>
      <p class="form-hint">8文字以上で、英字と数字をそれぞれ1文字以上含めてください。</p>

      <%= f.label :password_confirmation, "パスワード（確認）" %>
      <%= f.password_field :password_confirmation, class: 'form-control', autocomplete: "new-password" %>

      <%= f.submit "保存する", class: "btn btn-primary" %>
    <% end %>
    <p class="auth-links"><%= link_to "退会する", new_withdrawal_path %></p>
  </div>
</div>
